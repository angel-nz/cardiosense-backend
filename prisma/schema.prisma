generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
}

// NEW R (R4A) — personalization outcome of a NEW-R Prediction. NULL on a
// Prediction means a legacy / pre-NEW-R row (always a plain global
// prediction). Only these four values exist: there is deliberately no
// DEGRADED/APPLIED state (partial history exclusions keep INDIVIDUALIZED and
// are recorded in personalizationProvenance counts).
enum PersonalizationStatus {
  INDIVIDUALIZED
  GLOBAL_INSUFFICIENT_HISTORY
  GLOBAL_INCOMPATIBLE_HISTORY
  GLOBAL_ERROR_FALLBACK
}

// NEW S2E-FIX3 — WHY a Prediction exists. Server-internal metadata only (never
// accepted from a client; never used by R evidence/canonicalization/scores or
// by S bridge selection/forecasting). AUTOMATIC_HEALTH_RECORD = created by
// the record-creation path for that record; LEGACY_UNKNOWN = every row that
// existed before origin persistence (origin not reconstructible — never
// guessed). NEW S2E-FIX4 — manual Predictions are no longer a CardioSense
// capability: there is no MANUAL member. No DB default: every new row must be
// written with an explicit origin by server code.
enum PredictionOrigin {
  AUTOMATIC_HEALTH_RECORD
  LEGACY_UNKNOWN
}

// NEW S2A — provenance of a HealthRecord's REAL clinical time (S1 §2/§3).
//   CLINICIAN_ENTERED  measuredAt NOT NULL, captured for every NEW record
//                      (backend-assigned; never client-selectable)
//   LEGACY_ENTRY_TIME  measuredAt NULL — row predates explicit clinical time;
//                      only its entry-time recordedAt exists. Never back-
//                      filled into measuredAt. Excluded from S cadence
//                      inference (A2 = L-EXCLUDE-CADENCE).
// DB invariant (migration CHECK health_records_clinical_time_source_check):
//   (clinical_time_source = 'CLINICIAN_ENTERED') = (measured_at IS NOT NULL)
enum ClinicalTimeSource {
  CLINICIAN_ENTERED
  LEGACY_ENTRY_TIME
}

// NEW S2A — longitudinal risk forecasting S (S1 / S1-FIX1 / S1-FIX2,
// A1 = B typed bridge). Forecasts are SIMULATED projections: never a
// HealthRecord, never a Prediction, never R evidence / Π, never an Alert.
// Lifecycle-derived API states (PATIENT_INACTIVE / PATIENT_HIDDEN /
// PATIENT_LIFECYCLE_INVALID / NOT_EVALUATED) are NOT persisted.
enum ForecastEligibilityStatus {
  HISTORY_ABSENT
  HISTORY_INVALID
  CLINICAL_HISTORY_INSUFFICIENT
  FREQUENCY_UNRELIABLE
  FORECAST_ELIGIBLE
}

enum ForecastGenerationStatus {
  NOT_APPLICABLE
  GENERATED_FULL
  GENERATED_PARTIAL
  NONE_ADMISSIBLE
  FAILED
}

// GLOBAL = global Skorp only; INDIVIDUALIZED_BRIDGE = a compatible typed
// RForecastBridgeState was actually applied (never inferred from JSON).
enum ForecastRiskInterpretation {
  GLOBAL
  INDIVIDUALIZED_BRIDGE
}

enum ForecastTrigger {
  HEALTH_RECORD_CREATED
  ANCHOR_PREDICTION_PERSISTED
  DEMOGRAPHICS_CHANGED
  PATIENT_REACTIVATED
  BOOTSTRAP
}

enum ForecastSupersedeReason {
  NEW_REAL_RECORD
  ANCHOR_R_STATE_CHANGED
  DEMOGRAPHICS_CHANGED
  PATIENT_LEFT_ACTIVE
  PATIENT_LIFECYCLE_INVALID
  MODEL_OR_POLICY_VERSION_CHANGED
  RETRY_AFTER_FAILURE
}

// NEW S4 — durable automatic-Prediction obligation (one per accepted
// HealthRecord). Recoverable dependency failures never terminate a task:
// they cycle PENDING → PROCESSING → RETRY_WAIT → … → COMPLETED.
// NEW S4-FIX2 — BLOCKED is terminal. It covers (a) MODEL_INELIGIBLE: the
// record's clinical age is outside the CURRENT model's range (a historical,
// business/model-domain outcome: no Prediction, next_attempt_at NULL, never
// claimed, retried or resurrected by time or a later model release) and
// (b) genuine data invariants (RECORD_NOT_FOUND, PREDICTION_MISMATCH).
// Only (b) can be reopened (prediction:reconcile --reopen-blocked, clone/test).
// WAITING_MODEL_SUPPORT (S4-FIX1) is DEPRECATED and unreachable: kept only as
// an enum label to avoid enum surgery on clones; a DB CHECK forbids it.
enum AutomaticPredictionTaskStatus {
  PENDING
  PROCESSING
  RETRY_WAIT
  WAITING_MODEL_SUPPORT // deprecated (S4-FIX2): never written, forbidden by CHECK
  COMPLETED
  BLOCKED
}

// The ONLY legitimate bridge state. A single-value enum makes "a bridge row
// is always an INDIVIDUALIZED R outcome" a type-level (and DB enum-level)
// constraint rather than an application convention.
enum RForecastBridgeStatus {
  INDIVIDUALIZED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// Z5 — Configurable Information Alerts. The explicit, closed clinical/
// product cause a persisted INFO Alert was created for — a nullable
// column (not every Alert has one): every pre-Z5 Alert row (prediction-
// generated HIGH/MODERATE/ANOMALY) remains `type = NULL` forever, never
// retrofitted, and any FUTURE prediction-generated Alert also keeps
// `type = NULL` — that branch's own `realtimeCategory` mechanism
// (realtimeNotification.ts) is untouched by Z5 and deliberately not
// unified with this enum. `type` exists purely to identify which of these
// information events produced this row (for the NotificationPreference
// realtime-delivery lookup AlertService performs, and for future display
// refinement) — it is never used to derive severity (severity is passed
// explicitly at creation, same as every other Alert, and is always INFO
// for every value below).
//
// Z6-R2 §1/§2/§6/§7 — `INFO_DOCTOR_PROFILE_UPDATED` REMOVED. Editing a
// doctor's own profile (name, cédula, specialty, hospital, phone) is a
// withdrawn product decision for a persisted information Alert — it no
// longer creates one at all, and no replacement value is added. A forward
// migration (20260930223000_remove_doctor_profile_info_alert) deletes any
// historical rows of this type and safely recreates this Postgres enum
// without it (Postgres cannot simply DROP an enum value) — see that
// migration for the full reconciliation. Exactly three values remain.
enum AlertType {
  INFO_PATIENT_CREATED
  INFO_PATIENT_UPDATED
  INFO_HEALTH_RECORD_CREATED
}

// Y6.1 — three server-side states. SYSTEM is a first-class stored value
// (not merely a frontend fallback when no preference exists) — it means
// "explicitly follow the OS/browser color-scheme", distinct from a user who
// has never saved a preference at all (handled the same lazy no-row way
// NotificationPreference already is, not by ever writing SYSTEM implicitly).
enum AppearanceTheme {
  LIGHT
  DARK
  SYSTEM
}

// PRE-Y8 (Interface Size Preference) — a second, INDEPENDENT Appearance axis
// alongside AppearanceTheme, deliberately NOT the removed Y6.3B/Y6.4B
// interface-density/visibility PRESET system (that axis scaled many
// individual per-component tokens; this one is a single global scale factor
// applied uniformly via CSS `zoom` — see AppearanceContext.tsx/index.css).
// ORIGINAL is the exact pre-existing baseline (scale 1.00, no visual change
// from today), matching AppearanceTheme's own "SYSTEM is a first-class
// stored default" precedent — ORIGINAL is likewise a real, explicit,
// storable value, not merely "no preference set" (that lazy-no-row case is
// handled the same way as theme's, via the GET route's own default object,
// not by ever writing ORIGINAL implicitly).
enum InterfaceSize {
  ORIGINAL
  MEDIUM
  LARGE
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  // Z6-R1 — nullable so a doctor may register with phone only (no email at
  // all). Uniqueness is preserved for every NON-null value — Postgres
  // permits multiple NULL rows under a plain UNIQUE constraint/index, so
  // "no email" never conflicts with another "no email" account. Every
  // existing account keeps its real, non-null email unchanged. The
  // product invariant this supports (every MEDICO has email != null OR
  // doctor.phone != null) is enforced in application code (auth.dto.ts's
  // RegisterDto superRefine + user.routes.ts's PATCH /me/profile lockout
  // check below), never as a DB CHECK spanning User + Doctor.
  email        String?  @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  role         Role     @default(DOCTOR)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  doctor          Doctor?
  healthRecords   HealthRecord[]   @relation("CreatedByUser")
  refreshTokens   RefreshToken[]
  notificationPreference NotificationPreference?
  appearancePreference   AppearancePreference?
  // Y3.1B — one row max per user (Y3.1A-FIX1 storage decision: Postgres
  // binary storage, never bytes inline on this row). Absence of a related
  // row IS "no avatar" — no boolean flag duplicates that fact.
  avatarImage     AvatarImage?

  @@map("users")
}

// Y5.2 — rebuilt for the stable-session refresh architecture. `id` IS the
// session id ("sid") embedded in the refresh JWT — it is generated in
// application code (crypto.randomUUID(), see lib/session.ts) BEFORE the JWT
// containing it is signed, then passed explicitly as `id` on create (not
// left to Prisma's own @default(uuid()), which only applies when the field
// is omitted). Rotation (POST /auth/refresh) always UPDATEs this same row in
// place — the row's identity/creation history never changes across
// rotations, which is what makes it possible to preserve "this session"
// through Y5.1's adapted password-change flow and to list/revoke sessions
// individually (Y5.2 §Session Management). The raw refresh credential itself
// is NEVER persisted — only a SHA-256 hash of it (`tokenHash`), so a DB read
// (or leak) can never be replayed as a live refresh credential.
model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @map("token_hash")
  // Raw request header string only (`req.headers['user-agent']`), captured
  // once at session creation — never parsed, geolocated, or fingerprinted.
  // Nullable: the header can legitimately be absent.
  userAgent  String?  @map("user_agent")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  // Set at creation, updated ONLY on a successful refresh (never on every
  // ordinary authenticated API request) — see lib/session.ts.
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Supports GET /users/me/sessions (list this user's active sessions).
  @@index([userId])
  @@map("refresh_tokens")
}

// Y4 — rebuilt for the final Phase-Y Notifications contract: three
// independent realtime-delivery toggles, one per Alert cause. `highRiskAlerts`
// is RENAMED (not dropped+recreated) to `highRiskRealtime` so existing users'
// values survive (see the Y4 migration). `weeklySummary` is intentionally
// removed — that feature was never actually implemented, and Phase Y
// explicitly dropped the contract; its data is discarded, not migrated
// anywhere (Y4 §8).
model NotificationPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  highRiskRealtime     Boolean  @default(true) @map("high_risk_realtime")
  moderateRiskRealtime Boolean  @default(true) @map("moderate_risk_realtime")
  anomalyRealtime      Boolean  @default(true) @map("anomaly_realtime")
  // Z5 — four independent realtime-delivery toggles, one per Configurable
  // Information Alert event, following the EXACT same pattern the three
  // risk/anomaly fields above already established (Y4): each gates ONLY
  // the optional `new_alert` Socket.IO popup for its event — never Alert
  // persistence (the Alert row is always created — see AlertService/
  // realtimeNotification.ts) and never `alerts_changed` (always emitted
  // regardless). @default(true) so every EXISTING user — who has a
  // NotificationPreference row from before Z5, or has none at all yet
  // (the lazy-no-row GET default, see user.routes.ts) — starts with all
  // four new information alerts enabled, identical in spirit to how
  // highRiskRealtime/moderateRiskRealtime/anomalyRealtime already default
  // to true. The Z5 migration adds these as a plain column default, which
  // Postgres applies to already-existing rows in the same ADD COLUMN
  // statement — no separate backfill needed.
  patientCreatedRealtime         Boolean @default(true) @map("patient_created_realtime")
  patientUpdatedRealtime         Boolean @default(true) @map("patient_updated_realtime")
  healthRecordCreatedRealtime    Boolean @default(true) @map("health_record_created_realtime")
  // Z6-R2 §5/§6 — `doctorProfileUpdatedRealtime` REMOVED (column dropped by
  // the same forward migration that reconciles AlertType, see its enum's
  // own comment above): the one event it gated no longer exists as a
  // product decision, so there is nothing left for this toggle to control.
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// Y6.1 — mirrors NotificationPreference's exact structural pattern (one row
// per user, unique userId, lazy creation only on first PATCH). `theme`
// defaults to SYSTEM at the column level for symmetry with the app-level
// lazy default the GET route returns when no row exists yet — the two are
// deliberately kept in agreement so a future direct-DB read never disagrees
// with what the API has always told this user.
model AppearancePreference {
  id        String          @id @default(uuid())
  userId    String          @unique @map("user_id")
  theme     AppearanceTheme @default(SYSTEM)
  // PRE-Y8 (Interface Size Preference) — additive column, non-destructive to
  // any existing row: every pre-existing AppearancePreference row implicitly
  // became ORIGINAL (the exact then-current baseline) via the column
  // default, applied by the PRE-Y8 migration itself (ADD COLUMN ... NOT
  // NULL DEFAULT 'ORIGINAL' backfilled existing rows in that same
  // statement — no separate data migration/backfill script needed or
  // written then).
  //
  // Z4 / PRISMA GATE P2 — the column default changed from ORIGINAL to
  // MEDIUM (set_interface_size_default_medium migration), matching the
  // already-implemented Z4 application-level default. This is a
  // default-only change: it affects only a future INSERT that omits
  // interfaceSize. It is NOT a backfill — every row's already-stored
  // explicit value (ORIGINAL, MEDIUM, or LARGE) is left exactly as is.
  interfaceSize InterfaceSize @default(MEDIUM) @map("interface_size")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("appearance_preferences")
}

// Y3.1B — profile-image binary storage (Y3.1A/Y3.1A-FIX1 architecture,
// implemented here exactly as frozen). One row per user, never inline on
// User (Y3.1A §"never put raw avatar bytes on User"). `data` is read ONLY
// by the dedicated GET /users/me/avatar route — every other Prisma query
// touching a user (auth bootstrap, profile GET/PATCH) selects `updatedAt`
// alone, never `data` (Y3.1A-FIX1 §19/§25, Y3.1B §19/§42). Absence of a row
// is the sole "no avatar" signal — no separate boolean. onDelete: Cascade
// so a deleted User (if that ever happens) never leaves an orphaned image.
model AvatarImage {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  data      Bytes
  mimeType  String   @map("mime_type")
  byteSize  Int      @map("byte_size")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("avatar_images")
}

model Doctor {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  professionalLicense String?  @unique @map("professional_license")
  specialty           String?
  hospital           String?
  // Z6 — optional doctor contact phone, professional/personal profile
  // information belonging to Doctor (not User — User.email is the
  // login/auth identity, a completely separate concern). Nullable, no
  // unique constraint, no default/backfill: every existing Doctor row
  // simply gets `phone = NULL`. Persisted form is E.164 (see
  // lib/phone.ts::isCanonicalPhone, the exact same contract Patient.phone
  // already uses) — enforced at the DTO layer (user.routes.ts's
  // UpdateMyProfileDto), not here.
  //
  // Z6-R1 — now also a LOGIN IDENTIFIER (a doctor may authenticate by
  // phone, see auth.service.ts), so it must resolve to at most one Doctor:
  // `@unique`. Still nullable — a doctor may register/operate with email
  // only and no phone at all. Not made globally required; the "at least
  // one of email/phone" invariant lives in application code, not here.
  phone              String?  @unique
  createdAt          DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  patients Patient[]
  // Z5 — direct doctor-scoped Alert ownership, for an Alert that has no
  // legitimate patient to attach to. See Alert model below for the full
  // ownership design. Z6-R2 — the one event that ever populated this path
  // (INFO_DOCTOR_PROFILE_UPDATED) was removed as a product decision; this
  // relation/column and AlertRepository's doctor-scoped ownership query are
  // left in place as generic, currently-unused infrastructure (not
  // something named after the removed feature itself) rather than removed
  // — no live AlertType value creates a doctor-scoped Alert today.
  alerts    Alert[]

  @@map("doctors")
}

model Patient {
  id        String   @id @default(uuid())
  doctorId  String   @map("doctor_id")
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  birthDate DateTime @map("birth_date") @db.Date
  sex       Int      // 0 = Female, 1 = Male
  curp      String?  @unique
  phone     String?
  // Z6 — optional patient contact email. CONTACT INFORMATION only — this
  // patient is not a User account and this has no relationship to
  // login/auth (User.email, unique/required there). Nullable, no unique
  // constraint, no default/backfill: every existing Patient row simply
  // gets `email = NULL`. Normalized (trim + lowercase) at the DTO layer
  // (patient.dto.ts) before it ever reaches Prisma.
  email     String?
  isActive  Boolean  @default(true) @map("is_active")
  // Z8 — PATIENT LIFECYCLE & VISIBILITY MANAGEMENT. CardioSense never
  // deletes a patient (physically or logically) — isActive/isHidden are the
  // only two lifecycle/visibility axes, and they are DELIBERATELY SEPARATE
  // product concepts, not one combined status:
  //   isActive=true,  isHidden=false -> ACTIVE (normal, full clinical use)
  //   isActive=false, isHidden=false -> INACTIVE_VISIBLE (no new clinical
  //                                     activity; fully visible/browsable;
  //                                     reversible via the status endpoint)
  //   isActive=false, isHidden=true  -> INACTIVE_HIDDEN (fully preserved,
  //                                     excluded from every normal
  //                                     operational surface; reversible only
  //                                     through dedicated visibility-
  //                                     management endpoints/UI)
  // isActive=true + isHidden=true is an INVALID state application code must
  // never intentionally create — enforced entirely at the service layer
  // (patient.service.ts: the status endpoint rejects reactivating a hidden
  // patient; the visibility endpoint requires isActive=false to hide, and
  // SHOW never flips isActive back to true), not by a DB-level CHECK
  // constraint — only the one column this block authorizes was added, no
  // schema object beyond it. No deletedAt/hiddenAt/purgedAt/restoreToken —
  // none proved necessary: deactivating/hiding is reversible by construction
  // (the status/visibility endpoints themselves), so no restore workflow or
  // "when was this hidden" audit timestamp is needed yet.
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  healthRecords HealthRecord[]
  predictions   Prediction[]
  alerts        Alert[]

  // NEW S2A — forecast S (separate from REAL clinical/prediction history)
  riskForecastSets     RiskForecastSet[]
  riskForecasts        RiskForecast[]
  forecastBridgeStates RForecastBridgeState[]
  // NEW S4 — durable automatic-Prediction obligations (one per accepted record)
  automaticPredictionTasks AutomaticPredictionTask[]

  // Z8 — no new index added for isHidden/isActive filtering. The existing
  // @@index([doctorId]) above already makes every Z8 query (the Patients
  // list's ACTIVE/INACTIVE/ALL filter, the hidden-patient management
  // surface) an index-backed scan on doctorId with isActive/isHidden as
  // residual in-memory predicates — this project's current scale (patients
  // per doctor) gives no concrete, observed reason to add a speculative
  // composite index on top of that, per this block's own instruction not to
  // add one without one.
  @@index([doctorId])
  @@map("patients")
}

model HealthRecord {
  id             String   @id @default(uuid())
  patientId      String   @map("patient_id")
  recordedAt     DateTime @default(now()) @map("recorded_at")
  age            Int
  currentSmoker  Boolean  @map("current_smoker")
  cigsPerDay     Int      @default(0) @map("cigs_per_day")
  bpMeds         Boolean  @map("bp_meds")
  diabetes       Boolean
  totChol        Decimal  @map("tot_chol") @db.Decimal(6, 2)
  sysBP          Decimal  @map("sys_bp") @db.Decimal(5, 2)
  diaBP          Decimal  @map("dia_bp") @db.Decimal(5, 2)
  bmi            Decimal  @db.Decimal(5, 2)
  glucose        Decimal  @db.Decimal(6, 2)
  notes          String?
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  // NEW S2A / PRE-T-R1 — REAL clinical time, distinct from recordedAt
  // (technical entry/audit instant) and createdAt (DB insert default). R-BPBC-3
  // uses measuredAt as its causal clock and never falls back to recordedAt.
  //   measuredAt: UTC clock value, TIMESTAMP(3) WITHOUT TIME ZONE, written
  //   only through Prisma (session-timezone independent). Raw SQL must read
  //   it as (measured_at AT TIME ZONE 'UTC'). NULL ⇔ LEGACY_ENTRY_TIME.
  //   clinicalTimeSource: no @default on purpose — every create must state
  //   it; the backend assigns CLINICIAN_ENTERED (record.service.ts).
  measuredAt         DateTime?          @map("measured_at")
  clinicalTimeSource ClinicalTimeSource @map("clinical_time_source")

  patient     Patient     @relation(fields: [patientId], references: [id])
  creator     User         @relation("CreatedByUser", fields: [createdBy], references: [id])
  predictions Prediction[]

  // NEW S2A — inbound references only (forecast → record). R repositories
  // never include these relations.
  anchoredForecastSets RiskForecastSet[]
  forecastBridgeStates RForecastBridgeState[]
  // NEW S4 — the durable obligation to produce THIS record's ONE automatic Prediction
  automaticPredictionTask AutomaticPredictionTask?

  @@index([patientId])
  @@index([recordedAt])
  @@map("health_records")
}

model Prediction {
  id             String    @id @default(uuid())
  patientId      String    @map("patient_id")
  healthRecordId String?   @map("health_record_id")
  riskScore      Decimal   @map("risk_score") @db.Decimal(5, 4)
  riskLevel      RiskLevel @map("risk_level")
  anomalyScore   Decimal?  @map("anomaly_score") @db.Decimal(8, 4)
  isAnomaly      Boolean   @default(false) @map("is_anomaly")
  modelVersion   String?   @map("model_version")
  predictedAt    DateTime  @default(now()) @map("predicted_at")
  // NEW S2E-FIX3 — see enum PredictionOrigin. No @default on purpose.
  origin         PredictionOrigin @map("origin")

  // NEW R (R4A) — personalization persistence. All nullable, never
  // backfilled: every legacy / pre-NEW-R row keeps NULL in all five.
  //   riskScore (above)        = FUTURE final risk score (individualized or
  //                              exactly global on fallback)
  //   globalRiskScore          = FUTURE raw global Skorp score before
  //                              personalization; the ONLY score the
  //                              prediction-history channel may ever read
  //   personalizationStatus    = NEW-R outcome (NULL = legacy row)
  //   personalizationVersion   = e.g. "R-BPBC-3" (historical rows may remain R-BPBC-2)
  //   sexUsed                  = sex actually sent to the model (0|1)
  //   personalizationProvenance = audit JSON (counts, gamma, gains, bound,
  //                              fallback reason, evidence fingerprint) —
  //                              never raw input vectors
  // DB invariant (migration CHECK predictions_personalization_global_pair_check):
  //   (personalization_status IS NULL) = (global_risk_score IS NULL)
  globalRiskScore           Decimal?               @map("global_risk_score") @db.Decimal(5, 4)
  personalizationStatus     PersonalizationStatus? @map("personalization_status")
  personalizationVersion    String?                @map("personalization_version")
  sexUsed                   Int?                   @map("sex_used")
  personalizationProvenance Json?                  @map("personalization_provenance")

  patient       Patient      @relation(fields: [patientId], references: [id])
  healthRecord  HealthRecord? @relation(fields: [healthRecordId], references: [id])
  alerts        Alert[]

  // NEW S2A — inbound only: the typed bridge row a future S2 block may
  // capture for THIS REAL NEW-R Prediction (no column added here).
  forecastBridgeState RForecastBridgeState?
  // NEW S4 — the durable task this AUTOMATIC Prediction completed (if any)
  automaticPredictionTask AutomaticPredictionTask?

  @@index([patientId])
  @@index([predictedAt])
  // NEW R (R4A) — prediction-history (Π) lookups by HealthRecord. No
  // equivalent index existed before (audited: only patient_id/predicted_at).
  @@index([healthRecordId])
  @@map("predictions")
}

// Z5 — Configurable Information Alerts extended this model's ownership
// shape. Pre-Z5, every Alert was implicitly patient-scoped (patientId was
// NOT NULL). One of the Z5 events — INFO_DOCTOR_PROFILE_UPDATED, since
// removed by Z6-R2 — had no legitimate patient at all (it was about the
// doctor's own profile), so `patientId` became nullable and a second,
// independent ownership path was added: `doctorId`, direct doctor
// ownership, for exactly that case. This is NOT a redesign of
// patient-scoped Alerts — every prediction-generated and
// INFO_PATIENT_*/INFO_HEALTH_RECORD_CREATED Alert continues to set
// patientId exactly as before, with doctorId left null.
//
// Z6-R2 — no current AlertType value ever populates the doctor-scoped
// path anymore (its one producer was removed), but `doctorId` and the
// ownership mechanism below are kept as generic infrastructure for any
// future doctor-scoped Alert, not removed merely because their one past
// user was withdrawn.
//
// Invariant enforced by application code (AlertService.createInformationAlert),
// not a DB CHECK constraint (no other model in this schema uses one, so
// none is introduced here — see PRISMA GATE P2 precedent of minimal,
// focused changes): every Alert must have exactly one ownership path
// populated —
//   PATIENT-SCOPED:  patientId != null, doctorId == null
//   DOCTOR-SCOPED:   patientId == null, doctorId != null
// — never both null. AlertRepository's doctor-visibility queries
// (findByDoctor/findById/markRead/markAllRead) read EITHER path: an Alert
// belongs to the current doctor when `patient.doctorId == currentDoctorId`
// OR `alert.doctorId == currentDoctorId`, never broader.
model Alert {
  id           String        @id @default(uuid())
  patientId    String?       @map("patient_id")
  // Z5 — direct doctor ownership path. Z6-R2 — its one producer
  // (INFO_DOCTOR_PROFILE_UPDATED) was removed; no live code sets this
  // anymore, but the column/mechanism is preserved as generic
  // infrastructure (see model comment above). Left null for every
  // patient-scoped Alert, as always.
  doctorId     String?       @map("doctor_id")
  predictionId String?       @map("prediction_id")
  // Z5 — nullable: NULL for every pre-Z5 row and for every prediction-
  // generated HIGH/MODERATE/ANOMALY Alert going forward (that branch
  // keeps using its own realtimeCategory mechanism, untouched by Z5 — see
  // the AlertType enum comment above). Set to one of the AlertType values
  // ONLY by AlertService.createInformationAlert.
  type         AlertType?
  severity     AlertSeverity
  message      String
  isRead       Boolean       @default(false) @map("is_read")
  createdAt    DateTime      @default(now()) @map("created_at")

  patient    Patient?    @relation(fields: [patientId], references: [id])
  doctor     Doctor?     @relation(fields: [doctorId], references: [id])
  prediction Prediction? @relation(fields: [predictionId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([isRead])
  @@map("alerts")
}

// ════════════════════════════════════════════════════════════════════════════
// NEW S2A — FORECAST S PERSISTENCE (schema only; no producer exists yet)
// ════════════════════════════════════════════════════════════════════════════

// One row per S evaluation of one patient — exists even when zero forecasts
// are generated (HISTORY_ABSENT, …, NONE_ADMISSIBLE, FAILED).
//
// CURRENT marker: `currentForPatientId` = patientId while this set is the
// patient's CURRENT set, NULL once superseded. Its @unique gives "at most
// one CURRENT set per patient" with a Prisma-managed index (PostgreSQL
// UNIQUE admits many NULLs) — no partial index Prisma could later drift on.
// Raw-SQL CHECKs (migration plan) tie it to patientId and supersededAt:
//   risk_forecast_sets_current_marker_check:
//     current_for_patient_id IS NULL OR current_for_patient_id = patient_id
//   risk_forecast_sets_current_superseded_check:
//     (current_for_patient_id IS NULL) = (superseded_at IS NOT NULL)
model RiskForecastSet {
  id                  String          @id @default(uuid())
  patientId           String          @map("patient_id")
  currentForPatientId String?         @unique @map("current_for_patient_id")
  trigger             ForecastTrigger

  eligibilityStatus ForecastEligibilityStatus @map("eligibility_status")
  eligibilityReason String                    @map("eligibility_reason")
  eligibilityCounts Json                      @map("eligibility_counts")
  generationStatus  ForecastGenerationStatus  @map("generation_status")
  generationReason  String?                   @map("generation_reason")

  // REAL anchor / knowledge cutoff (NULL when no usable clinician-timed anchor)
  anchorHealthRecordId     String?             @map("anchor_health_record_id")
  knowledgeCutoff          DateTime?           @map("knowledge_cutoff")
  cutoffLocalDay           DateTime?           @map("cutoff_local_day") @db.Date
  anchorClinicalTimeSource ClinicalTimeSource? @map("anchor_clinical_time_source")

  // Cadence (S-CAD-1): raw Δ (median of integer local-day gaps → .0 or .5)
  // and the integer Δd used for target dates.
  cadenceDaysRaw Decimal? @map("cadence_days_raw") @db.Decimal(6, 2)
  cadenceDays    Int?     @map("cadence_days")
  cadenceMethod  String?  @map("cadence_method")
  cadenceReason  String?  @map("cadence_reason")
  // NEW S4 — S-CAD-3: the exact 3-interval horizon sequence (days). Unimodal
  // [d,d,d]; multimodal e.g. [7,21,7]. Empty for pre-S4 sets / abstentions.
  cadenceIntervalsDays Int[] @default([]) @map("cadence_intervals_days")

  // Scoring semantics. NULL when no forecast was scored. rBridgeStateId is a
  // COMPUTATIONAL input reference (typed bridge row); rBridgeReason records
  // why a bridge was not applied (GLOBAL fallback). No descriptive R context.
  riskInterpretation ForecastRiskInterpretation? @map("risk_interpretation")
  rBridgeStateId     String?                     @map("r_bridge_state_id")
  rBridgeReason      String?                     @map("r_bridge_reason")

  sVersion                  String  @map("s_version")
  featurePolicyVersion      String  @map("feature_policy_version")
  clinicalTimePolicyVersion String  @map("clinical_time_policy_version")
  cadencePolicyVersion      String  @map("cadence_policy_version")
  modelVersion              String? @map("model_version")
  inputFingerprint          String  @map("input_fingerprint") @db.Char(64)

  createdAt         DateTime                 @default(now()) @map("created_at")
  supersededAt      DateTime?                @map("superseded_at")
  supersededBySetId String?                  @unique @map("superseded_by_set_id")
  supersedeReason   ForecastSupersedeReason? @map("supersede_reason")

  patient      Patient              @relation(fields: [patientId], references: [id])
  anchorRecord HealthRecord?         @relation(fields: [anchorHealthRecordId], references: [id])
  rBridgeState RForecastBridgeState? @relation(fields: [rBridgeStateId], references: [id])
  supersededBy RiskForecastSet?      @relation("ForecastSetSupersession", fields: [supersededBySetId], references: [id])
  supersedes   RiskForecastSet?      @relation("ForecastSetSupersession")
  forecasts    RiskForecast[]

  @@index([patientId, createdAt])
  @@map("risk_forecast_sets")
}

// One projected horizon (1..3) of a set. Child of RiskForecastSet only — no
// relation to HealthRecord or Prediction. Scores use the Prediction score
// type (Decimal(5,4)); riskLevel reuses RiskLevel.
// Raw-SQL CHECKs (migration plan): horizon_index BETWEEN 1 AND 3; both scores
// in [0, 1].
model RiskForecast {
  id           String   @id @default(uuid())
  setId        String   @map("set_id")
  patientId    String   @map("patient_id")
  horizonIndex Int      @map("horizon_index") @db.SmallInt
  targetDate   DateTime @map("target_date") @db.Date
  targetAge    Int      @map("target_age")

  simulatedState    Json @map("simulated_state")
  featureProvenance Json @map("feature_provenance")
  assumptionFlags   Json @map("assumption_flags")
  // NEW S4 — S-FEAT-SEQUENTIAL-ROBUST-2 per-horizon context provenance
  // (REAL record count, in-run simulated context, weights, per-feature
  // rawSlope / trendConsistency / effectiveSlope). NULL for pre-S4 rows.
  sequentialContext Json? @map("sequential_context")

  globalRiskScore Decimal   @map("global_risk_score") @db.Decimal(5, 4)
  finalRiskScore  Decimal   @map("final_risk_score") @db.Decimal(5, 4)
  riskLevel       RiskLevel @map("risk_level")
  createdAt       DateTime  @default(now()) @map("created_at")

  set     RiskForecastSet @relation(fields: [setId], references: [id])
  patient Patient        @relation(fields: [patientId], references: [id])

  @@unique([setId, horizonIndex])
  @@index([patientId])
  @@map("risk_forecasts")
}

// Typed forecast-only R bridge (A1 = B). At most one per REAL NEW-R
// Prediction, and only when that Prediction's R outcome was INDIVIDUALIZED.
// appliedLogit is the typed decisive value returned by the AI in that same
// REAL prediction call — NEVER parsed from personalizationProvenance JSON,
// never approximated from rounded scores, never backfilled (existing NEW-R
// Predictions have no bridge row). No producer exists in S2A.
// Raw-SQL CHECKs (migration plan): sex_used IN (0,1); applied_logit finite.
model RForecastBridgeState {
  id                     String                @id @default(uuid())
  predictionId           String                @unique @map("prediction_id")
  healthRecordId         String                @map("health_record_id")
  patientId              String                @map("patient_id")
  personalizationVersion String                @map("personalization_version")
  modelVersion           String                @map("model_version")
  sexUsed                Int                   @map("sex_used")
  anchorAge              Int                   @map("anchor_age")
  status                 RForecastBridgeStatus
  appliedLogit           Float                 @map("applied_logit")
  bridgeVersion          String                @map("bridge_version")
  createdAt              DateTime              @default(now()) @map("created_at")

  prediction   Prediction        @relation(fields: [predictionId], references: [id])
  healthRecord HealthRecord      @relation(fields: [healthRecordId], references: [id])
  patient      Patient          @relation(fields: [patientId], references: [id])
  forecastSets RiskForecastSet[]

  @@index([patientId])
  @@index([healthRecordId])
  @@map("r_forecast_bridge_states")
}

// NEW S4 — durable automatic-Prediction work item. Created ATOMICALLY with
// its HealthRecord (same transaction); processed after COMMIT by the
// automatic-Prediction worker (FOR UPDATE SKIP LOCKED + bounded lease).
// lastErrorCode is a short sanitized category only (never a stack trace,
// payload, key or URL).
model AutomaticPredictionTask {
  id             String                        @id @default(uuid())
  healthRecordId String                        @unique @map("health_record_id")
  patientId      String                        @map("patient_id")
  status         AutomaticPredictionTaskStatus @default(PENDING)
  attemptCount   Int                           @default(0) @map("attempt_count")
  nextAttemptAt  DateTime?                     @default(now()) @map("next_attempt_at") // NULL only for terminal BLOCKED
  lastAttemptAt  DateTime?                     @map("last_attempt_at")
  leaseUntil     DateTime?                     @map("lease_until")
  leaseOwner     String?                       @map("lease_owner")
  predictionId   String?                       @unique @map("prediction_id")
  completedAt    DateTime?                     @map("completed_at")
  lastErrorCode  String?                       @map("last_error_code")
  createdAt      DateTime                      @default(now()) @map("created_at")
  updatedAt      DateTime                      @updatedAt @map("updated_at")

  healthRecord HealthRecord @relation(fields: [healthRecordId], references: [id])
  patient      Patient     @relation(fields: [patientId], references: [id])
  prediction   Prediction?  @relation(fields: [predictionId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([patientId])
  @@map("automatic_prediction_tasks")
}
